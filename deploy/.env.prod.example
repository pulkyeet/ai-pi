# Production environment for the Fly machines (api + worker share one image).
#
# Values here are placeholders only — real values are never committed. The
# Fly machines get secrets from GitHub Actions at deploy time
# (.github/workflows/deploy.yml, which reads GitHub Secrets and calls
# `fly secrets set`), and the GitHub Actions jobs themselves read the same
# GitHub Secrets directly. This file's job is to document the full set and
# what each variable is for; copy it only as a checklist, never as config.

# --- core ---------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# OTEL_CONSOLE_EXPORT=false        # OTLP-export traces instead of console-printing

# Direct Postgres connection to Supabase — NOT the pooler. The app runtime
# (asyncpg) needs `?ssl=require`; alembic/psql/pg_dump (libpq) need
# `?sslmode=require`. Same thing, two spellings — see docs/runbook.md.
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres?ssl=require

# --- vendor keys ---------------------------------------------------------------
OPENROUTER_API_KEY=<placeholder>
EXA_API_KEY=<placeholder>
GITHUB_TOKEN=<placeholder>
# PRODUCTHUNT_TOKEN=<placeholder>  # optional; unset -> retriever degrades

# --- Supabase Auth (JWT verification is JWKS-based; SUPABASE_JWT_SECRET is
# --- never read by application code) -----------------------------------------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# --- Langfuse tracing (optional; unset -> no-op tracer) ------------------------
# LANGFUSE_PUBLIC_KEY=<placeholder>
# LANGFUSE_SECRET_KEY=<placeholder>
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Phase 13 frontend origin(s) for CORS (JSON list) --------------------------
CORS_ALLOW_ORIGINS=["https://ai-pi-kohl.vercel.app"]

# --- quota knobs (derived values, docs/tuning.md dated 2026-08-08) --------------
RUN_BUDGET_WEIGHT=70
RUN_BUDGET_USD=0.25
RUN_TIMEOUT_S=640
MAX_COMPETITORS_PROFILED=8
MAX_PAGES_PER_ENTITY=4
MAX_COMMUNITY_THREADS=20
GLOBAL_RUNS_PER_DAY=4
RUNS_PER_USER_PER_DAY=3
MAX_CONCURRENT_RUNS=2
EXA_DAILY_CREDIT_CAP_USD=0.33
EXA_GLOBAL_DAILY_CREDIT_CAP_USD=0.33

# --- CI/ops-only (never needed inside a Fly machine) ---------------------------
# Direct connection strings used by GitHub Actions (backup, keepalive,
# migrations, nightly storage maintenance):
#   SUPABASE_DB_URL=postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   SUPABASE_DB_URL_ASYNC=postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres?ssl=require
#
# R2 object storage for nightly backups (deploy/backup.sh, GitHub Actions only):
#   R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID=<placeholder>
#   R2_SECRET_ACCESS_KEY=<placeholder>
#   R2_BUCKET=ai-pi-backups
