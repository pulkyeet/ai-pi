# Copy to .env.local for local dev.

# FastAPI backend (src/api/web) origin. The homepage/benchmark pages are
# statically rendered at build time against this URL and ship with zero
# runtime dependency on it (phase-13-frontend.md).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project (matches api.config.Settings.supabase_url on the backend).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public; the secret key stays server-side in
# the FastAPI backend's TURNSTILE_SECRET_KEY).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
