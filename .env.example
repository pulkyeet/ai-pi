# Copy to .env and fill in. Settings has no defaults for secrets, so a
# missing required value raises at startup rather than at first use.

ENVIRONMENT=dev
LOG_LEVEL=INFO
OTEL_CONSOLE_EXPORT=true

# Local Postgres (docker-compose) by default; point at Supabase in prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_pi

OPENROUTER_API_KEY=
EXA_API_KEY=
GITHUB_TOKEN=

# --- LLM gateway (Phase 05) ---
# LLM_MODEL defaults to deepseek/deepseek-v4-flash (validated in Phase 01).
# Langfuse is optional — unset keys fall back to a no-op tracer.
# LLM_MODEL=deepseek/deepseek-v4-flash
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Quota knobs (masterplan §8.2) ---
# Derived from Phase 14's six live tuning-benchmark runs (docs/tuning.md,
# docs/benchmark.md dated 2026-08-08) rather than guessed. Uncomment to
# enforce; commented out here means "unenforced," same as before Phase 14 —
# a deployment should uncomment these deliberately.
# RUNS_PER_USER_PER_DAY=3        # judgement call, not derived from benchmark data
# GLOBAL_RUNS_PER_DAY=4          # derived: (Exa $10/mo / 30) / p95 search-$/run
# MAX_CONCURRENT_RUNS=2          # judgement call: single-worker deployment + GitHub Search's 30/min cap
# RUN_BUDGET_WEIGHT=70           # derived: p95 observed plan weight (47) * 1.5 headroom
# RUN_BUDGET_USD=0.25            # derived: p95 observed cost * 3 (bug insurance, not cost control)
# RUN_TIMEOUT_S=640              # derived: p95 duration * 2 -- no consumer wired yet, see docs/tuning.md
# MAX_COMPETITORS_PROFILED=8     # kept at the existing default; no sweep performed this session
# MAX_PAGES_PER_ENTITY=4         # kept at the existing default; no clear signal to change it
# MAX_COMMUNITY_THREADS=20       # derived: doubled to partially relieve a real per-pair floor bug, see docs/tuning.md

# --- Exa credit allowance guardrails (masterplan §8.2, Phase 04) ---
# Both collapse to the same $10/mo recurring allowance / 30 days check.
# EXA_DAILY_CREDIT_CAP_USD=0.33
# EXA_GLOBAL_DAILY_CREDIT_CAP_USD=0.33

# --- Supabase Auth + frontend origin (Phase 12/13/15, prod-only) ---
# Unset locally -> the web API has no auth configured (JWT verification cannot
# resolve a key) and no browser origin is CORS-allowlisted; `make unit` still
# runs. Every real deployment needs both, with the Vercel frontend origin
# listed. Full prod checklist incl. the direct DB URL (asyncpg ?ssl=require vs
# libpq ?sslmode=require) lives in deploy/.env.prod.example.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# CORS_ALLOW_ORIGINS=["https://ai-pi-kohl.vercel.app"]
